# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Server-side (proxy.ts, Server Actions) — validated in src/lib/env.ts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service secret (new format sb_secret_*, for server-only ops) — optional, not validated at boot
# SUPABASE_SECRET_KEY=sb_secret_...

# Client-side — only if you add browser Supabase client (NEXT_PUBLIC inlined)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App — used for redirects, auth callback URL
SITE_URL=http://localhost:3000

# NVIDIA NIM / Nemotron — https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_NEMOTRON_MODEL_NAME=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Make — Donation Email Dispatch (see docs/integrations/make/)
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/...
# MAKE_WEBHOOK_API_KEY=...

# Deferred — Make/Resend adapter (see docs/integrations/make/MAKE_HOOK_2703382_RED_CONTRACT.md)
# RESEND_API_KEY=re_...
# HANDLY_SIGNATURE_SECRET=...
