# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Server-side (proxy.ts, Server Actions) — validated in src/lib/env.ts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Client-side — only if you add browser Supabase client (NEXT_PUBLIC inlined)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App — used for redirects, auth callback URL
SITE_URL=http://localhost:3000

# Deferred — Make/Resend adapter (see docs/integrations/make/MAKE_HOOK_2703382_RED_CONTRACT.md)
# MAKE_WEBHOOK_URL=https://hook.make.com/...
# RESEND_API_KEY=re_...
# HANDLY_SIGNATURE_SECRET=...
