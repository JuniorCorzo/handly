# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Server-side (proxy.ts, Server Actions) — validated in src/lib/env.ts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service secret (new format sb_secret_*, for server-only ops) — optional, not validated at boot
# SUPABASE_SECRET_KEY=sb_secret_...

# Client-side — only if you add browser Supabase client (NEXT_PUBLIC inlined)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App — used for redirects, auth callback URL
SITE_URL=http://localhost:3000

# Make — Donation Email Dispatch (see docs/integrations/make/)
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/...
# MAKE_WEBHOOK_API_KEY=...

# Resend (deferred)
# RESEND_API_KEY=re_...
# HANDLY_SIGNATURE_SECRET=...
