              "mapper": {
                "to": ["{{2.recipient_email}}"],
                "from": "noreply@handly.angelcorzo.dev",
                "html": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Progreso de Meta - Handly</title>\r\n  <style>\r\n    body { font-family: {{25.font_family}}; background-color: {{25.bg_main}}; margin: 0; padding: 0; color: #333333; }\r\n    .container { max-width: 600px; margin: 30px auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); }\r\n    .header { background: {{25.brand_primary_gradient}}; padding: 30px 20px; text-align: center; color: #ffffff; }\r\n    .header h1 { margin: 0; font-size: 26px; font-weight: 700; letter-spacing: -0.5px; }\r\n    .badge { display: inline-block; background-color: rgba(255, 255, 255, 0.25); padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-top: 10px; text-transform: uppercase; letter-spacing: 0.5px; }\r\n    .content { padding: 30px 25px; }\r\n    .greeting { font-size: 18px; font-weight: 600; color: {{25.text_dark}}; margin-bottom: 12px; }\r\n    .message { font-size: 15px; line-height: 1.6; color: #4b5563; margin-bottom: 25px; }\r\n    .card { background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin-bottom: 25px; }\r\n    .card-title { font-size: 14px; text-transform: uppercase; color: #6b7280; font-weight: 700; margin-bottom: 12px; letter-spacing: 0.5px; }\r\n    .data-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f3f4f6; font-size: 15px; }\r\n    .data-label { color: #6b7280; }\r\n    .data-value { font-weight: 600; color: {{25.text_dark}}; }\r\n    .progress-box { margin-top: 15px; background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 12px; text-align: center; color: #065f46; font-weight: 600; font-size: 15px; }\r\n    .cta-button { display: block; width: 100%; text-align: center; background-color: {{25.text_dark}}; color: #ffffff !important; text-decoration: none; padding: 14px 0; border-radius: 8px; font-weight: 600; font-size: 16px; margin-top: 20px; }\r\n    .footer { background-color: {{25.bg_main}}; padding: 20px; text-align: center; font-size: 12px; color: #9ca3af; border-top: 1px solid #f3f4f6; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div class=\"container\">\r\n    <div class=\"header\">\r\n      <h1>{{if(2.data.goal_type = \"campaign\"; \"¡Campaña Acelerando! 🏆\"; \"¡Hito Alcanzado! 🎯\")}}</h1>\r\n      <div class=\"badge\">{{if(2.data.goal_type = \"campaign\"; \"Progreso de Campaña\"; \"Progreso de Insumo\")}}</div>\r\n    </div>\r\n    <div class=\"content\">\r\n      <div class=\"greeting\">¡Hola, equipo de {{2.data.org_name}}!</div>\r\n      <div class=\"message\">{{if(2.data.goal_type = \"campaign\"; \"¡Grandes noticias! Se ha alcanzado el <strong>\" + round((2.data.goal_reached / 2.data.goal) * 100) + \"%</strong> de la meta global para la campaña <strong>\" + 2.data.campaign_name + \"</strong>.\"; \"¡Excelente progreso! Se ha alcanzado el <strong>\" + round((2.data.goal_reached / 2.data.goal) * 100) + \"%</strong> del objetivo para el insumo <strong>\" + 2.data.item_name + \"</strong> en la campaña <strong>\" + 2.data.campaign_name + \"</strong>.\")}}</div>\r\n      <div class=\"card\">\r\n        <div class=\"card-title\">{{if(2.data.goal_type = \"campaign\"; \"Resumen de la Campaña\"; \"Detalle del Insumo\")}}</div>\r\n        <div class=\"data-row\"><span class=\"data-label\">Campaña:</span><span class=\"data-value\">{{2.data.campaign_name}}</span></div>\r\n        {{if(2.data.goal_type != \"campaign\"; \"<div class='data-row'><span class='data-label'>Ítem:</span><span class='data-value'>\" + 2.data.item_name + \"</span></div>\"; )}}\r\n        <div class=\"data-row\"><span class=\"data-label\">Meta objetivo:</span><span class=\"data-value\">{{2.data.goal}} unidades</span></div>\r\n        <div class=\"progress-box\">📈 Recolectado/comprometido: <strong>{{2.data.goal_reached}} unidades ({{round((2.data.goal_reached / 2.data.goal) * 100)}}%)</strong></div>\r\n      </div>\r\n      <p class=\"message\">{{if(2.data.goal_type = \"campaign\"; \"Gracias a la respuesta de los donantes, la campaña avanza a firme paso. Podés gestionar y revisar los acopios desde tu panel.\"; \"Gracias al compromiso de la comunidad, los cupos para este insumo se siguen completando. Podés revisar el estado del acopio desde tu panel.\")}}</p>\r\n      <a href=\"https://handly.app/dashboard\" class=\"cta-button\">Ir al Panel de Gestión</a>\r\n    </div>\r\n    <div class=\"footer\">Este es un mensaje automático generado por <strong>Handly</strong> en respuesta a eventos de la campaña.<br>© 2026 Handly. Todos los derechos reservados.</div>\r\n  </div>\r\n</body>\r\n</html>",
                "subject": "{{if(2.data.goal_type = \"campaign\"; \"🎉 ¡Campaña Completada!\"; \"🎯 Meta Alcanzada en Ítem\")}} — {{2.data.campaign_name}}",
                "sendEmailAs": "html"
