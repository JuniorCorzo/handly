                "sendEmailAs": "html",
                "html": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Compromiso de Donación - Handly</title>\r\n  <style>\r\n    body {\r\n      font-family: {{25.font_family}};\r\n      background-color: {{25.bg_main}};\r\n      margin: 0;\r\n      padding: 0;\r\n      color: #333333;\r\n    }\r\n    .container {\r\n      max-width: 600px;\r\n      margin: 30px auto;\r\n      background-color: #ffffff;\r\n      border-radius: 12px;\r\n      overflow: hidden;\r\n      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\r\n    }\r\n    .header {\r\n      background: {{25.brand_primary}};\r\n      background: {{25.brand_primary_gradient}};\r\n      color: #ffffff;\r\n      padding: 30px 20px;\r\n      text-align: center;\r\n    }\r\n    .header h1 {\r\n      margin: 0;\r\n      font-size: 24px;\r\n      font-weight: 700;\r\n    }\r\n    .content {\r\n      padding: 30px 25px;\r\n    }\r\n    .greeting {\r\n      font-size: 18px;\r\n      font-weight: 600;\r\n      color: {{25.text_dark}};\r\n      margin-bottom: 12px;\r\n    }\r\n    .message {\r\n      font-size: 15px;\r\n      line-height: 1.6;\r\n      color: #475569;\r\n      margin-top: 0;\r\n    }\r\n    .code-box {\r\n      background-color: #fff7ed;\r\n      border: 2px dashed {{25.brand_primary}};\r\n      border-radius: 10px;\r\n      padding: 20px;\r\n      text-align: center;\r\n      margin: 25px 0;\r\n    }\r\n    .code-title {\r\n      font-size: 13px;\r\n      text-transform: uppercase;\r\n      letter-spacing: 1px;\r\n      color: #c2410c;\r\n      font-weight: 700;\r\n      margin-bottom: 6px;\r\n    }\r\n    .code-value {\r\n      font-size: 32px;\r\n      font-weight: 800;\r\n      color: {{25.brand_primary}};\r\n      letter-spacing: 3px;\r\n      font-family: monospace;\r\n    }\r\n    .code-expiration {\r\n      font-size: 12px;\r\n      color: #9a3412;\r\n      margin-top: 8px;\r\n    }\r\n    .card {\r\n      background-color: #f8fafc;\r\n      border: 1px solid #e2e8f0;\r\n      border-radius: 8px;\r\n      padding: 18px;\r\n      margin-bottom: 20px;\r\n    }\r\n    .card-title {\r\n      font-size: 14px;\r\n      font-weight: 700;\r\n      color: #334155;\r\n      text-transform: uppercase;\r\n      letter-spacing: 0.5px;\r\n      margin-bottom: 12px;\r\n      border-bottom: 1px solid #e2e8f0;\r\n      padding-bottom: 6px;\r\n    }\r\n    .data-table {\r\n      width: 100%;\r\n      border-collapse: collapse;\r\n      font-size: 14px;\r\n    }\r\n    .data-table td {\r\n      padding: 4px 0;\r\n    }\r\n    .data-label {\r\n      color: #64748b;\r\n    }\r\n    .data-value {\r\n      font-weight: 600;\r\n      color: #0f172a;\r\n      text-align: right;\r\n    }\r\n    .location-list {\r\n      list-style-type: none;\r\n      padding-left: 0;\r\n      margin: 0;\r\n    }\r\n    .footer {\r\n      background-color: {{25.bg_main}};\r\n      padding: 20px;\r\n      text-align: center;\r\n      font-size: 12px;\r\n      color: #94a3b8;\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <div class=\"container\">\r\n    <div class=\"header\">\r\n      <h1>¡Compromiso Confirmado! 🤝</h1>\r\n    </div>\r\n\r\n    <div class=\"content\">\r\n      <div class=\"greeting\">¡Hola, {{2.data.donor_name}}!</div>\r\n      <p class=\"message\">\r\n        Muchas gracias por sumar tu apoyo a la campaña <strong>\"{{2.data.campaign_name}}\"</strong> organizada por <strong>{{2.data.org_name}}</strong>. Tu aporte marcará una diferencia enorme.\r\n      </p>\r\n\r\n      <div class=\"code-box\">\r\n        <div class=\"code-title\">Tu Código de Confirmación</div>\r\n        <div class=\"code-value\">{{2.data.commitment_code}}</div>\r\n        <div class=\"code-expiration\">⏰ Tenés tiempo de entregar hasta el: <strong>{{2.data.expires_at}}</strong> antes de que el compromiso expire.</div>\r\n      </div>\r\n\r\n      <div class=\"card\">\r\n        <div class=\"card-title\">📦 Resumen del Recibo</div>\r\n        <table class=\"data-table\">\r\n          <tr>\r\n            <td class=\"data-label\">Ítem a entregar:</td>\r\n            <td class=\"data-value\">{{2.data.item_name}}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"data-label\">Cantidad comprometida:</td>\r\n            <td class=\"data-value\">{{2.data.quantity}} unidades</td>\r\n          </tr>\r\n        </table>\r\n      </div>\r\n\r\n      <div class=\"card\">\r\n        <div class=\"card-title\">📍 Puntos de Acopio Disponibles</div>\r\n        <p style=\"font-size: 13px; color: #64748b; margin-top: 0; margin-bottom: 12px;\">\r\n          Podés realizar la entrega en cualquiera de estos lugares presentando tu código:\r\n        </p>\r\n        <ul class=\"location-list\">\r\n          {{24.text}}\r\n        </ul>\r\n      </div>\r\n\r\n      <p class=\"message\" style=\"font-size: 13px; color: #64748b; text-align: center;\">\r\n        Recuerda dictar o mostrar tu código <strong>{{2.data.commitment_code}}</strong> al entregar las provisiones en la sede para que los coordinadores registren el ingreso.\r\n      </p>\r\n    </div>\r\n\r\n    <div class=\"footer\">\r\n      Este es un comprobante automático de tu compromiso con <strong>Handly</strong>.<br>\r\n      © 2026 Handly. Todos los derechos reservados.\r\n    </div>\r\n  </div>\r\n\r\n</body>\r\n</html>"
